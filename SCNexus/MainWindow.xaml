<Window Foreground="{DynamicResource Text}" x:Class="SCNexus.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCNexus.Controls" Title="SC NEXUS" Icon="Assets/sc-nexus.ico" Width="1360" Height="900" MinWidth="1040" MinHeight="680" Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
    </Window.Resources>
    <Grid Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,14,12,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="Assets/sc-nexus.png" Width="38" Height="38" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Margin="11,1,0,0">
                            <TextBlock Text="SC NEXUS" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="ОПЕРАЦИИ ПОЛЁТА" FontSize="8" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="14,12">
                    <TextBlock Text="ЛОКАЛЬНОЕ РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenDashboardCommand}" Tag="{Binding IsDashboardOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Обзор" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenHaulingCommand}" Tag="{Binding IsHaulingOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Маршруты" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenFleetCommand}" Tag="{Binding IsFleetOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Корабли" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenEquipmentCommand}" Tag="{Binding IsEquipmentOpen}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Оснащение"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenHistoryCommand}" Tag="{Binding IsHistoryOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Журнал" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenToolsCommand}" Tag="{Binding IsToolsOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Инструменты" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}" Tag="{Binding IsSettingsOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="28,18,28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="{Binding CurrentShip}" Foreground="{DynamicResource Text}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="АКТИВНЫЙ КОРАБЛЬ" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                            <StackPanel><TextBlock Text="{Binding HaulingBudgetDisplay}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding DashboardBudgetLabel}" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True" Padding="24,18,24,24">
                <Grid MaxWidth="1440" HorizontalAlignment="Stretch">
                    <StackPanel Visibility="{Binding IsDashboardOpen, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource WorkspaceSection}" Padding="18,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DashboardActionHeading}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DashboardActionTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DashboardActionDetails}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding DashboardActionButtonText}" Command="{Binding OpenDashboardActionCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="18,0,0,0" />
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="16,13" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardShipLabel}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CurrentShip}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DashboardShipCapacityDisplay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Border}" />
                                <StackPanel Grid.Column="2" Margin="18,0">
                                    <TextBlock Text="{Binding DashboardLocationLabel}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DashboardLocationDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{DynamicResource Border}" />
                                <StackPanel Grid.Column="4" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding DashboardBudgetLabel}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding HaulingBudgetDisplay}" Foreground="{DynamicResource Accent}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource WorkspaceSection}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="18,16">
                                    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Открыть журнал" Command="{Binding OpenHistoryCommand}" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}"/><TextBlock Text="Последние рейсы" Style="{StaticResource SectionTitle}" Margin="0"/></DockPanel>
                                    <ItemsControl ItemsSource="{Binding RecentFlights}">
                                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateDisplay}" Style="{StaticResource Hint}"/><TextBlock Grid.Column="1" Text="{Binding ShipName}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding ResultDisplay}" Foreground="{DynamicResource Accent}" Margin="12,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Завершённые рейсы появятся здесь." Style="{StaticResource Hint}" Visibility="{Binding HasNoRecentFlights, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Border}" Margin="0,16" />
                                <StackPanel Grid.Column="2" Margin="18,16">
                                    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Сканировать ASOP" Command="{Binding DetectShipFromOverlayCommand}" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}"/><TextBlock Text="Состояние игры" Style="{StaticResource SectionTitle}" Margin="0"/></DockPanel>
                                    <TextBlock Text="{Binding GameProcessStatus}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LiveLocationDisplay}" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding LiveMissionTitle}" Margin="0,12,0,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding LiveMissionHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding DataCollectionStatus}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsHaulingOpen, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource WorkspaceSection}" Visibility="{Binding HasActiveVoyage, Converter={StaticResource BoolVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardActionHeading}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ActiveVoyageStopDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ActiveVoyageActionDisplay}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="24,0,0,0">
                                    <TextBlock Text="{Binding ActiveVoyageProfitDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Назад" Command="{Binding PreviousVoyageStopCommand}" Margin="0,0,8,0" />
                                        <Button Content="Далее" Command="{Binding NextVoyageStopCommand}" Visibility="{Binding CanAdvanceVoyage, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" />
                                        <Button Content="Убрать" Command="{Binding CancelVoyageGuidanceCommand}" ToolTip="Скрыть подсказку маршрута. Запись рейса сохранится в журнале." />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Корабль" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip}" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Начальная локация" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RouteStartSelector" ItemsSource="{Binding RouteStartSystems}" SelectedItem="{Binding RouteStartSystem, Mode=TwoWay}" ToolTip="Все системы или конкретная система отправления"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Режим" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding VoyageModes}" SelectedItem="{Binding VoyageMode}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Подобрать" Command="{Binding FindRoutesCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <StackPanel Visibility="{Binding IsMultiVoyage, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Точек закупки" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VoyageStopLimits}" SelectedItem="{Binding VoyageMaxPurchases}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Конечная точка" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VoyageDestinations}" SelectedItem="{Binding VoyageDestination}" DisplayMemberPath="Display" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Expander x:Name="RouteFilters" Header="Фильтры" IsExpanded="False" Margin="0,0,0,12">
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Безопасность" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                                        <CheckBox Content="Исключить опасные" IsChecked="{Binding ExcludeDangerousRoutes, Mode=TwoWay}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Исключить Pyro" IsChecked="{Binding AvoidPyro, Mode=TwoWay}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Включить терминалы NQA" IsChecked="{Binding AllowRisky, Mode=TwoWay}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Только рейсы внутри одной системы" IsChecked="{Binding HaulingSameSystemOnly, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Бюджет и ограничения" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Категория маршрута" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding HaulingCategories}" SelectedItem="{Binding HaulingCategory, Mode=TwoWay}" Margin="0,4,0,8"/>
                                        <TextBlock Text="Минимум заполнения, %" Style="{StaticResource FieldLabel}"/>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MinimumFillPercent, Mode=TwoWay}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding MinimumFillPercent, StringFormat={}{0}%}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Минимум прибыли, aUEC" Style="{StaticResource FieldLabel}"/><TextBox Margin="0,4,0,0"><TextBox.Text><Binding Path="MinimumProfit" UpdateSourceTrigger="LostFocus" Converter="{StaticResource MoneyConverter}"><Binding.ValidationRules><ui:MoneyRule/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Денежный резерв, aUEC" Style="{StaticResource FieldLabel}"/><TextBox Margin="0,4,0,0"><TextBox.Text><Binding Path="Reserve" UpdateSourceTrigger="LostFocus" Converter="{StaticResource MoneyConverter}"><Binding.ValidationRules><ui:MoneyRule/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Системы маршрута" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
                                <ItemsControl ItemsSource="{Binding RouteSystems}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,18,8"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Выбрать все" Command="{Binding SelectAllRouteSystemsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Очистить выбор" Command="{Binding ClearRouteSystemsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Сбросить фильтры" Command="{Binding ResetRouteFiltersCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding RouteSystemsSummary}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding HaulingStatus}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsMarketLoading, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding VoyageStatus}" Visibility="{Binding IsMultiVoyage, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsVoyageLoading, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" />
                        <ui:RouteResultsView />
                        <TextBlock Text="Запас и спрос меняются в игре. Перед закупкой проверь терминал; прибыль рассчитана по последним котировкам UEX." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsFleetOpen, Converter={StaticResource BoolVisibility}}">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Мой флот" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding FleetSummary}" Style="{StaticResource Hint}" Margin="14,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Добавить корабль" Padding="12,8" Click="ExpandAddShip_Click"/>
                        </Grid>
                        <Grid MinHeight="470">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,22,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Background="{DynamicResource Input}" Margin="1" Height="40">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Корабль" Style="{StaticResource FieldLabel}" Margin="14,12,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Роль" Style="{StaticResource FieldLabel}" Margin="8,12,0,0"/>
                                        <TextBlock Grid.Column="2" Text="Груз" Style="{StaticResource FieldLabel}" Margin="8,12,0,0"/>
                                        <TextBlock Grid.Column="3" Text="Статус" Style="{StaticResource FieldLabel}" Margin="8,12,0,0"/>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="14,10" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Ship.BuildNotes}" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding CargoDisplay}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="● В составе флота" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Image Source="{Binding SelectedShipPortrait}" Height="150" Stretch="UniformToFill" Visibility="{Binding HasSelectedShipPortrait, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,14"/>
                                <TextBlock Text="{Binding SelectedShip.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedShip.Role}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SelectedShipPortraitStatus}" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                                <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,14"><StackPanel><TextBlock Text="ГРУЗОВОЙ ОБЪЁМ" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedShip.CargoDisplay}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                                <TextBlock Text="{Binding SelectedShip.BuildNotes}" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                                <Button Content="Выбрать для рейсов" Command="{Binding UseShipCommand}" CommandParameter="{Binding SelectedShip}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Оснащение" Command="{Binding OpenEquipmentCommand}" CommandParameter="{Binding SelectedShip}" Margin="0,8,0,0"/>
                                <Button Content="Удалить" Command="{Binding DeleteShipCommand}" CommandParameter="{Binding SelectedShip}" Background="Transparent" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Expander x:Name="AddShipPanel" Header="Добавить корабль" IsExpanded="{Binding HasNoShips, Mode=OneTime}" Margin="0,18,0,0">
                            <StackPanel Margin="0,12,0,0" MaxWidth="650">
                                <TextBlock Text="Каталог UEX" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CatalogShips}" SelectedItem="{Binding SelectedCatalogVehicle, Mode=TwoWay}" DisplayMemberPath="Display"/>
                                <TextBox Text="{Binding CatalogQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Введи часть названия корабля" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding VehicleStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Добавить корабль" Command="{Binding AddShipCommand}" IsEnabled="{Binding HasSelectedCatalogVehicle}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Expander>

