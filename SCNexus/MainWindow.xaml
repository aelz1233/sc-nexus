<Window x:Class="SCNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC NEXUS" Width="1300" Height="820" MinWidth="1000" MinHeight="650"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="#252E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB7D1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource HeroBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="19,13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#090E1D" BorderBrush="#222C48" BorderThickness="0,0,0,1">
            <Grid Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource HeroBrush}" Margin="0,0,11,0"><TextBlock Text="✦" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="SC NEXUS" FontSize="18" FontWeight="Bold" Foreground="White"/><TextBlock Text="ЛИЧНЫЙ КОМПАНЬОН" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Nav}" Content="⌂  Главная" Command="{Binding OpenDashboardCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="✦  Корабли" Command="{Binding OpenFleetCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="▣  Перевозки" Command="{Binding OpenHaulingCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="↗  Рейсы и история" Command="{Binding OpenHistoryCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="▦  Инструменты" Command="{Binding OpenToolsCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="⚙  Настройки" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#14223B" BorderBrush="#2B3D61" BorderThickness="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="●  ЛОКАЛЬНЫЕ ДАННЫЕ" Foreground="#8FB5FF" FontSize="10" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="38,28,38,42">
                <StackPanel Visibility="{Binding IsDashboardOpen, Converter={StaticResource BoolVisibility}}">
                    <Border Background="{StaticResource HeroSurfaceBrush}" BorderBrush="#2B3460" BorderThickness="1" CornerRadius="20" Padding="32,26" Margin="0,0,0,22">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#1B2848" BorderBrush="#344879" BorderThickness="1" CornerRadius="14" Padding="13,6" HorizontalAlignment="Center"><TextBlock Text="●  STAR CITIZEN  ·  ЛИЧНЫЙ ЦЕНТР" Foreground="#A7C1FF" FontSize="11"/></Border>
                            <TextBlock Text="SC NEXUS" FontSize="48" FontWeight="Bold" Foreground="{StaticResource HeroTitleBrush}" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                            <TextBlock Text="Корабли, рейсы и торговые маршруты в одном месте" FontSize="17" Foreground="#B5C1DC" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RecommendCommand}" Content="Найти торговый маршрут  →" FontSize="16" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="ЛИЧНЫЙ ОБЗОР" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Мои данные" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,19"/>
                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Background="{StaticResource BalanceBrush}" BorderBrush="#435687"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="БАЛАНС"/><TextBlock Text="{Binding BalanceDisplay}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ"/><TextBlock Text="{Binding CurrentShip}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="Сменить" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0" Background="Transparent" Foreground="{StaticResource Accent}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЛОКАЦИЯ"/><TextBlock Text="{Binding LocationDisplay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="Сменить" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0" Background="Transparent" Foreground="{StaticResource Accent}"/></StackPanel></Border>
                    </Grid>
                    <Grid Margin="0,0,0,21">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЗАРАБОТАНО СЕГОДНЯ"/><TextBlock Text="{Binding TodayProfitDisplay}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЗА ВСЕ РЕЙСЫ"/><TextBlock Text="{Binding TotalFlightProfitDisplay}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЛИЧНАЯ ПРИБЫЛЬ В ЧАС"/><TextBlock Text="{Binding PersonalProfitHourDisplay}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border Background="#17223E" BorderBrush="#334A85" BorderThickness="1" CornerRadius="13" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock Text="{Binding DataStatus}" Foreground="#B9CEED" FontSize="11"/></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="РЕЗУЛЬТАТ ПОИСКА" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding RecommendationMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="ПОДХОДЯЩИЕ МАРШРУТЫ" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Commodity}" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding ScuDisplay}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="КУПИТЬ"/><TextBlock Text="{Binding BuyAt}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ПРОДАТЬ"/><TextBlock Text="{Binding SellAt}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Caption}" Text="ОЖИДАЕМАЯ ПРИБЫЛЬ"/><TextBlock Text="{Binding ProfitDisplay}" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,16,0,0">
                                        <TextBlock Text="Закупка: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding InvestmentDisplay}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Доходность: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding RoiDisplay}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding FreshnessDisplay}" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding RiskDisplay}" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding PersonalDurationDisplay}" Foreground="{StaticResource Muted}"/>
                                    </WrapPanel>
                                    <Button Content="Записать этот рейс" Command="{Binding DataContext.PrepareFlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,7,0,12">
                        <TextBlock Text="{Binding RecommendedCountDisplay}" Foreground="{StaticResource Muted}"/>
                        <Button Content="Показать ещё 30 маршрутов" Command="{Binding ShowMoreRoutesCommand}"
                                Visibility="{Binding HasMoreRoutes, Converter={StaticResource BoolVisibility}}"
                                HorizontalAlignment="Left" Margin="0,9,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Данные UEX поддерживаются игроками. Объёмы — последние сообщения/прогноз спроса; наличие и время рейса не гарантированы." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsHaulingOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="ТОРГОВЛЯ  ·  UEX" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Грузоперевозки" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Выбери корабль и сравни рейсы по прибыли, вложениям и заполнению трюма." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="МЕСТНЫЕ" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Одна луна или планета" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="ПЛАНЕТАРНЫЕ" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Между точками одной планеты" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="ЗВЁЗДНЫЕ" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Между планетами системы" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="МЕЖЗВЁЗДНЫЕ" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Между разными системами" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
                        <TextBlock Text="ПЛАНИРОВЩИК РЕЙСА" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ"/><ComboBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="СОРТИРОВКА"/><ComboBox ItemsSource="{Binding HaulingSortOptions}" SelectedItem="{Binding HaulingSortMode, Mode=TwoWay}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ТРЮМ"/><TextBlock Text="{Binding SelectedShip.Ship.CargoScu, StringFormat={}{0:N0} SCU}" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,15,0,0"><TextBlock Style="{StaticResource Caption}" Text="ТИП МАРШРУТА"/><ComboBox ItemsSource="{Binding HaulingCategories}" SelectedItem="{Binding HaulingCategory, Mode=TwoWay}" Width="210" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
                        <CheckBox Content="Только рейсы внутри одной системы" IsChecked="{Binding HaulingSameSystemOnly, Mode=TwoWay}" Foreground="White" Margin="0,16,0,9"/>
                        <CheckBox Content="Включить терминалы NQA" IsChecked="{Binding AllowRisky, Mode=TwoWay}" Foreground="White" Margin="0,0,0,9"/>
                        <TextBlock Text="{Binding HaulingBudgetDisplay, StringFormat=Доступно на закупку с учётом резерва: {0}}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding HaulingStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}" Background="{StaticResource BalanceBrush}" BorderBrush="#394C7E" Margin="0,0,0,18" Visibility="{Binding HasHaulingBestRoute, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="ЛУЧШИЙ ПО ВЫБРАННОЙ СОРТИРОВКЕ" Foreground="#9DBBFF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HaulingBestRoute.Commodity}" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding HaulingBestRoute.ProfitDisplay}" Foreground="{StaticResource Accent}" FontSize="25" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding HaulingBestRoute.RouteDisplay}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding HaulingBestRoute.CargoDisplay}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding HaulingBestRoute.InvestmentDisplay, StringFormat=Нужно на закупку: {0}}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="МАРШРУТЫ ПО ЖИВЫМ КОТИРОВКАМ" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding HaulingRoutes}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Commodity}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding RouteDisplay}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="{Binding ProfitDisplay}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding ProfitPerScuDisplay}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,13,0,0"><TextBlock Text="{Binding CategoryDisplay}" Foreground="#9DBBFF" Margin="0,0,16,0"/><TextBlock Text="{Binding CargoDisplay}" Margin="0,0,16,0"/><TextBlock Text="{Binding RoiDisplay}" Margin="0,0,16,0"/><TextBlock Text="{Binding RiskDisplay}" Foreground="{StaticResource Muted}"/></WrapPanel>
                            <WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding InvestmentDisplay, StringFormat=Закупка: {0}}" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/><TextBlock Text="{Binding AvailabilityDisplay}" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/><TextBlock Text="{Binding UpdatedDisplay}" Foreground="{StaticResource Muted}"/></WrapPanel>
                            <Button Content="Записать этот рейс" Command="{Binding DataContext.PrepareHaulingFlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Запас и спрос меняются в игре. Перед закупкой проверь терминал; прибыль рассчитана по последним котировкам UEX." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsFleetOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Мой флот" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Найди модель в каталоге, выбери её и добавь в свой флот. Вместимость подставится сама." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <TextBlock Text="ВЫБРАТЬ КОРАБЛЬ ИЗ КАТАЛОГА" Foreground="{StaticResource Accent}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ ИЗ СПИСКА"/>
                            <ComboBox ItemsSource="{Binding ShipMatches}" SelectedItem="{Binding SelectedCatalogVehicle, Mode=TwoWay}"
                                      Text="{Binding ShipSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Name"
                                      IsDropDownOpen="{Binding ShowShipMatches, Mode=TwoWay}" MaxDropDownHeight="260" Margin="0,6,0,6">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="White"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding VehicleStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,17"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="ВЫБРАННЫЙ КОРАБЛЬ"/><TextBlock Text="{Binding NewShipName}" FontSize="18" Foreground="{StaticResource Accent}" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="ВМЕСТИМОСТЬ"/><TextBlock Text="{Binding NewShipCargoScu, StringFormat={}{0} SCU}" FontSize="18" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="РОЛЬ · ОПРЕДЕЛЯЕТСЯ АВТОМАТИЧЕСКИ, МОЖНО ИЗМЕНИТЬ" Margin="0,16,0,0"/>
                            <TextBox Text="{Binding NewShipRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="СБОРКА И ЗАМЕТКИ" Margin="0,16,0,0"/>
                            <TextBox Text="{Binding NewShipBuild, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Добавить корабль" Command="{Binding AddShipCommand}" IsEnabled="{Binding HasSelectedCatalogVehicle}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <TextBlock Text="МОИ КОРАБЛИ" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SortedShips}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="ГРУЗОВОЙ ОБЪЁМ"/><TextBlock Text="{Binding CargoDisplay}" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ЗАРАБОТАНО"/><TextBlock Text="{Binding EarnedDisplay}" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding BuildNotes}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Выбрать для рейсов" Command="{Binding DataContext.UseShipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                <Button Content="Удалить" Command="{Binding DataContext.DeleteShipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding FlightStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Рейсы и история" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Приложение запишет время и рассчитает прибыль по фактическим суммам." Foreground="{StaticResource Muted}" Margin="0,0,0,19"/>
                    <TextBlock Text="{Binding ActiveFlightDisplay}" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                        <TextBlock Text="МАРШРУТ И ФАКТИЧЕСКИЕ СУММЫ" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Выбери корабль из своего флота для этого рейса. При завершении прибыль добавится к балансу." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ ДЛЯ РЕЙСА"/>
                        <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding CargoScu, StringFormat=Вместимость выбранного корабля: {0} SCU}" Foreground="{StaticResource Muted}" Margin="0,0,0,17"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ОТКУДА"/><TextBox Text="{Binding FlightOrigin, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="КУДА"/><TextBox Text="{Binding FlightDestination, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ТОВАР"/><TextBox Text="{Binding FlightCommodity, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ВЛОЖЕНО"/><TextBox Text="{Binding FlightInvestment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ПОЛУЧЕНО"/><TextBox Text="{Binding FlightRevenue, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="РАСХОДЫ"/><TextBox Text="{Binding FlightExpenses, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Caption}" Text="ПОТЕРИ"/><TextBox Text="{Binding FlightLosses, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Начать рейс" Command="{Binding StartFlightCommand}" Margin="0,0,10,0"/><Button Content="Завершить рейс" Command="{Binding FinishFlightCommand}" IsEnabled="{Binding HasActiveFlight}"/></StackPanel>
                        <TextBlock Text="{Binding FlightStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
                        <TextBlock Text="НАЙДЕНО В ЖУРНАЛЕ ИГРЫ" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GameLogStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,5"/>
                        <TextBlock Text="Журнал показывает запросы к терминалу. Подставь сумму в рейс только после проверки сделки в игре." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding GameTrades}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeDisplay}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding KindDisplay}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding AmountDisplay}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding DetailsDisplay}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button Grid.Column="3" Content="Подставить" Command="{Binding DataContext.UseGameTradeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,7"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                    <TextBlock Text="ИСТОРИЯ" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Flights}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding DateDisplay}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ShipName}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Commodity}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Origin}"/><TextBlock Text=" → "/><TextBlock Text="{Binding Destination}"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding ProfitDisplay}" FontWeight="Bold"/><TextBlock Text="{Binding DurationDisplay}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Вложено: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Investment, StringFormat={}{0:N0} aUEC}"/><TextBlock Text="    Получено: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Revenue, StringFormat={}{0:N0} aUEC}"/><TextBlock Text="    Расходы и потери: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Expenses, StringFormat={}{0:N0}}"/><TextBlock Text=" + "/><TextBlock Text="{Binding Losses, StringFormat={}{0:N0} aUEC}"/></StackPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <StackPanel Visibility="{Binding IsToolsOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="STAR CITIZEN  ·  ФУНКЦИИ В SC NEXUS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Инструменты" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Мониторинг игры и проверка установки работают прямо здесь. Данные берутся с этого компьютера." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource Card}" Background="{StaticResource BalanceBrush}" BorderBrush="#394C7E" Margin="0,0,0,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="МОНИТОР ИГРЫ" Foreground="#9DBBFF" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GameProcessStatus}" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,5"/>
                                <TextBlock Text="{Binding GameRegion}" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding GameShard, StringFormat=Сервер: {0}}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding GameLogUpdated, StringFormat=Журнал обновлён: {0}}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding GameLogStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Открыть журнал" Command="{Binding OpenHistoryCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="ПРОВЕРКА УСТАНОВКИ" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
                    <ItemsControl ItemsSource="{Binding GameHealthFindings}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,9"><StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="ДНЕВНИК СЕССИЙ" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <TextBlock Text="{Binding SessionStatus}" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding GameSessions}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DateDisplay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding ServerDisplay}" FontWeight="SemiBold"/><TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
                        </Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Проверка только читает файлы. Игровые настройки и локализация не изменяются." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Background="Transparent" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Настройки" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                        <TextBlock Text="Изменения сохраняются автоматически на этом компьютере." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="БАЛАНС aUEC"/>
                        <TextBox Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩИЙ КОРАБЛЬ"/>
                        <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding CargoScu, StringFormat=Грузовой объём: {0} SCU}" Foreground="{StaticResource Muted}" Margin="0,0,0,19"/>
                        <TextBlock Style="{StaticResource Caption}" Text="СИСТЕМА"/>
                        <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem, Mode=TwoWay}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩАЯ ЛОКАЦИЯ"/>
                        <TextBox Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,6"/>
                        <Border Background="#0E1923" BorderBrush="#385465" BorderThickness="1" CornerRadius="6" Visibility="{Binding ShowLocationSuggestions, Converter={StaticResource BoolVisibility}}">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredLocations}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Display}" Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Background="Transparent"/>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding LocationStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,8"/>
                        <Button Content="Искать из всех локаций" Command="{Binding ClearLocationCommand}" HorizontalAlignment="Left" Margin="0,0,0,19"/>
                        <TextBlock Style="{StaticResource Caption}" Text="НЕ ТРАТИТЬ ПОСЛЕДНИЕ, aUEC"/>
                        <TextBox Text="{Binding Reserve, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <CheckBox Content="Учитывать рискованные терминалы NQA" IsChecked="{Binding AllowRisky}" Foreground="White" Margin="0,0,0,18"/>
                        <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource Accent}" Margin="0,0,0,24"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Вернуться на главную" Command="{Binding OpenDashboardCommand}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
