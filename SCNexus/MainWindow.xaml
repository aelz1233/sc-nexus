<Window x:Class="SCNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC NEXUS" Width="1300" Height="820" MinWidth="1000" MinHeight="650"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="#2A3844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCD9E2"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#07141B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="19,13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0C131B" BorderBrush="#263442" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,27,16,22">
                <TextBlock DockPanel.Dock="Bottom" Text="Личные данные на этом компьютере" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                <StackPanel>
                    <TextBlock Text="SC NEXUS" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold" Margin="8,0,0,3"/>
                    <TextBlock Text="ЛИЧНЫЙ КОМПАНЬОН" Foreground="{StaticResource Muted}" FontSize="10" Margin="9,0,0,35"/>
                    <Button Style="{StaticResource Nav}" Content="Главная" Command="{Binding OpenDashboardCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="Мой флот" Command="{Binding OpenFleetCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="Рейсы и история" Command="{Binding OpenHistoryCommand}"/>
                    <Button Style="{StaticResource Nav}" Content="Настройки" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="34,28,34,40">
                <StackPanel Visibility="{Binding IsDashboardOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="ЛИЧНЫЙ ОБЗОР" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Что делать сейчас?" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Твой баланс, корабль и лучшие торговые возможности в одном месте." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Background="#14343D" BorderBrush="#23616A"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="БАЛАНС"/><TextBlock Text="{Binding BalanceDisplay}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ"/><TextBlock Text="{Binding CurrentShip}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="Сменить" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0" Background="Transparent" Foreground="{StaticResource Accent}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЛОКАЦИЯ"/><TextBlock Text="{Binding LocationDisplay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="Сменить" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0" Background="Transparent" Foreground="{StaticResource Accent}"/></StackPanel></Border>
                    </Grid>
                    <Grid Margin="0,0,0,21">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЗАРАБОТАНО СЕГОДНЯ"/><TextBlock Text="{Binding TodayProfitDisplay}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЗА ВСЕ РЕЙСЫ"/><TextBlock Text="{Binding TotalFlightProfitDisplay}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЛИЧНАЯ ПРИБЫЛЬ В ЧАС"/><TextBlock Text="{Binding PersonalProfitHourDisplay}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RecommendCommand}" FontSize="21" Padding="24,20" HorizontalContentAlignment="Center" Content="ПОДОБРАТЬ ЛУЧШИЙ РЕЙС →"/>
                    <TextBlock Text="{Binding DataStatus}" Foreground="{StaticResource Muted}" Margin="0,12,0,24"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="РЕЗУЛЬТАТ ПОИСКА" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding RecommendationMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="ПОДХОДЯЩИЕ МАРШРУТЫ" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Commodity}" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding ScuDisplay}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="КУПИТЬ"/><TextBlock Text="{Binding BuyAt}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ПРОДАТЬ"/><TextBlock Text="{Binding SellAt}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Caption}" Text="ОЖИДАЕМАЯ ПРИБЫЛЬ"/><TextBlock Text="{Binding ProfitDisplay}" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,16,0,0">
                                        <TextBlock Text="Закупка: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding InvestmentDisplay}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Доходность: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding RoiDisplay}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding FreshnessDisplay}" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding RiskDisplay}" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding PersonalDurationDisplay}" Foreground="{StaticResource Muted}"/>
                                    </WrapPanel>
                                    <Button Content="Записать этот рейс" Command="{Binding DataContext.PrepareFlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Данные UEX поддерживаются игроками. Объёмы — последние сообщения/прогноз спроса; наличие и время рейса не гарантированы." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsFleetOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Мой флот" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Добавь корабли один раз. Приложение запомнит их объём, роль и заработок." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="НОВЫЙ КОРАБЛЬ" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,17"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="НАЗВАНИЕ"/><TextBox Text="{Binding NewShipName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="ОБЪЁМ ГРУЗА, SCU"/><TextBox Text="{Binding NewShipCargoScu, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="РОЛЬ"/><TextBox Text="{Binding NewShipRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="СБОРКА И ЗАМЕТКИ" Margin="0,16,0,0"/>
                            <TextBox Text="{Binding NewShipBuild, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Добавить корабль" Command="{Binding AddShipCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <TextBlock Text="МОИ КОРАБЛИ" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SortedShips}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="ГРУЗОВОЙ ОБЪЁМ"/><TextBlock Text="{Binding CargoDisplay}" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ЗАРАБОТАНО"/><TextBlock Text="{Binding EarnedDisplay}" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding BuildNotes}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Выбрать для рейсов" Command="{Binding DataContext.UseShipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                <Button Content="Удалить" Command="{Binding DataContext.DeleteShipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding FlightStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Рейсы и история" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Приложение запишет время и рассчитает прибыль по фактическим суммам." Foreground="{StaticResource Muted}" Margin="0,0,0,19"/>
                    <TextBlock Text="{Binding ActiveFlightDisplay}" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                        <TextBlock Text="МАРШРУТ И ФАКТИЧЕСКИЕ СУММЫ" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Корабль берётся из моего флота. При завершении прибыль добавится к балансу." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ОТКУДА"/><TextBox Text="{Binding FlightOrigin, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="КУДА"/><TextBox Text="{Binding FlightDestination, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ТОВАР"/><TextBox Text="{Binding FlightCommodity, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ВЛОЖЕНО"/><TextBox Text="{Binding FlightInvestment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ПОЛУЧЕНО"/><TextBox Text="{Binding FlightRevenue, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="РАСХОДЫ"/><TextBox Text="{Binding FlightExpenses, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Caption}" Text="ПОТЕРИ"/><TextBox Text="{Binding FlightLosses, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Начать рейс" Command="{Binding StartFlightCommand}" Margin="0,0,10,0"/><Button Content="Завершить рейс" Command="{Binding FinishFlightCommand}" IsEnabled="{Binding HasActiveFlight}"/></StackPanel>
                        <TextBlock Text="{Binding FlightStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="ИСТОРИЯ" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Flights}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding DateDisplay}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ShipName}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Commodity}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Origin}"/><TextBlock Text=" → "/><TextBlock Text="{Binding Destination}"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding ProfitDisplay}" FontWeight="Bold"/><TextBlock Text="{Binding DurationDisplay}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Вложено: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Investment, StringFormat={}{0:N0} aUEC}"/><TextBlock Text="    Получено: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Revenue, StringFormat={}{0:N0} aUEC}"/><TextBlock Text="    Расходы и потери: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Expenses, StringFormat={}{0:N0}}"/><TextBlock Text=" + "/><TextBlock Text="{Binding Losses, StringFormat={}{0:N0} aUEC}"/></StackPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <Border Background="Transparent" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Настройки" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/>
                        <TextBlock Text="Изменения сохраняются автоматически на этом компьютере." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="БАЛАНС aUEC"/>
                        <TextBox Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩИЙ КОРАБЛЬ"/>
                        <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShipSortOptions}" SelectedItem="{Binding ShipSortMode, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding CargoScu, StringFormat=Грузовой объём: {0} SCU}" Foreground="{StaticResource Muted}" Margin="0,0,0,19"/>
                        <TextBlock Style="{StaticResource Caption}" Text="СИСТЕМА"/>
                        <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem, Mode=TwoWay}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩАЯ ЛОКАЦИЯ"/>
                        <TextBox Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,6"/>
                        <Border Background="#0E1923" BorderBrush="#385465" BorderThickness="1" CornerRadius="6" Visibility="{Binding ShowLocationSuggestions, Converter={StaticResource BoolVisibility}}">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredLocations}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Display}" Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Background="Transparent"/>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding LocationStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,19"/>
                        <TextBlock Style="{StaticResource Caption}" Text="НЕ ТРАТИТЬ ПОСЛЕДНИЕ, aUEC"/>
                        <TextBox Text="{Binding Reserve, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <CheckBox Content="Учитывать рискованные терминалы NQA" IsChecked="{Binding AllowRisky}" Foreground="White" Margin="0,0,0,18"/>
                        <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource Accent}" Margin="0,0,0,24"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Вернуться на главную" Command="{Binding OpenDashboardCommand}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
