                                    <StackPanel>
                                        <TextBlock Text="Подключение к Star Citizen" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Установка игры" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ResolvedGameDirectory}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <WrapPanel Visibility="{Binding NeedsManualGamePath, Converter={StaticResource BoolVisibility}}">
                                            <Button Content="Выбрать папку игры" Command="{Binding ChooseGameFolderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" />
                                            <Button Content="Найти автоматически" Command="{Binding AutoDetectGameCommand}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Text="Ручной выбор нужен только если установка не найдена автоматически." Style="{StaticResource Hint}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
<Border Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Автоматический мониторинг" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Game.log отслеживается постоянно" FontWeight="SemiBold" />
                                        <TextBlock Text="Nexus читает только новые строки журнала. Интервал OCR выбирается в настройках данных и автоматизации." Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DataCollectionStatus}" Foreground="{DynamicResource Accent}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                        </StackPanel></TabItem>
                        <TabItem Header="Оверлей"><StackPanel>
<Border Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Игровой оверлей" Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12" MaxWidth="460" HorizontalAlignment="Left">
                                            <StackPanel Width="390">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="SC NEXUS" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OverlayDangerDisplay}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" FontSize="10" Visibility="{Binding OverlayDanger, Converter={StaticResource BoolVisibility}}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding OverlayShipDisplay}" FontWeight="SemiBold" FontSize="15" Margin="0,9,0,0"/>
                                                <TextBlock Text="{Binding OverlayLocationDisplay}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                                <StackPanel Visibility="{Binding OverlayHasRoute, Converter={StaticResource BoolVisibility}}">
                                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,9,0,8"/>
                                                    <TextBlock Text="{Binding OverlayActionHeading}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10"/>
                                                    <TextBlock Text="{Binding OverlayActionDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding OverlayStopDisplay}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Content="{Binding OverlayPreviewButtonText}" Command="{Binding ToggleOverlayPreviewCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button Content="{Binding OverlayDetectShipButtonText}" Command="{Binding DetectShipFromOverlayCommand}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding OverlayShipDetectionStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                        </WrapPanel>

                                        <CheckBox IsChecked="{Binding OverlayControlsEnabled}" Content="Кнопки в оверлее (отключи для кликов сквозь него)" Margin="0,0,0,9" />
                                        <CheckBox IsChecked="{Binding OverlayEnabled}">
                                            <TextBlock Text="Показывать оверлей при запущенном Star Citizen" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding OverlayExpanded}">
                                            <TextBlock Text="Расширенный вид: следующая остановка" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="Бинд показать / скрыть" Style="{StaticResource FieldLabel}" Margin="0,10,0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button x:Name="OverlayHotkeyCaptureButton" Content="{Binding OverlayHotkeyCaptureText}"
                                                    Style="{StaticResource HotkeyCaptureButton}" Click="BeginOverlayHotkeyCapture_Click"
                                                    PreviewKeyDown="OverlayHotkeyCapture_PreviewKeyDown"
                                                    LostKeyboardFocus="OverlayHotkeyCapture_LostKeyboardFocus" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Очистить" Click="ClearOverlayHotkey_Click" />
                                        </Grid>
                                        <TextBlock Text="{Binding OverlayHotkeyStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding OverlayCompatibilityHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="Можно нажать любую свободную комбинацию клавиатуры. Escape отменяет запись, Delete очищает бинд." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="{Binding OverlayEditorButtonText}" Command="{Binding ToggleOverlayEditorCommand}" Margin="0,0,8,0" />
                                        </WrapPanel>
                                        <Expander Header="Внешний вид и состав" Margin="0,14,0,0">
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="Положение" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding OverlayAnchorOptions}" DisplayMemberPath="Display"
                                                          SelectedValuePath="Value" SelectedValue="{Binding OverlayAnchor}" />
                                                <Grid Margin="0,12,0,2">
                                                    <TextBlock Text="Масштаб" Style="{StaticResource FieldLabel}" Margin="0" />
                                                    <TextBlock Text="{Binding OverlayScaleDisplay}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider Minimum="0.75" Maximum="1.5" Value="{Binding OverlayScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Margin="0,8,0,2">
                                                    <TextBlock Text="Прозрачность фона" Style="{StaticResource FieldLabel}" Margin="0" />
                                                    <TextBlock Text="{Binding OverlayOpacityDisplay}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider Minimum="0.65" Maximum="1" Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Margin="0,8,0,2">
                                                    <TextBlock Text="Прозрачность текста" Style="{StaticResource FieldLabel}" Margin="0" />
                                                    <TextBlock Text="{Binding OverlayTextOpacityDisplay}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider Minimum="0.65" Maximum="1" Value="{Binding OverlayTextOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <WrapPanel Margin="0,9,0,0">
                                                    <CheckBox IsChecked="{Binding OverlayShowShip}" Content="Корабль" Margin="0,7,18,7" />
                                                    <CheckBox IsChecked="{Binding OverlayShowLocation}" Content="Локация" Margin="0,7,18,7" />
                                                    <CheckBox IsChecked="{Binding OverlayShowRoute}" Content="Маршрут" Margin="0,7,18,7" />
                                                </WrapPanel>
                                                <Button Content="Вернуть справа снизу" Command="{Binding ResetOverlayPositionCommand}" HorizontalAlignment="Left" Margin="0,9,0,0" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="Кнопки оверлея можно включить или отключить. Nexus не внедряется в Star Citizen." Style="{StaticResource Hint}" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Border>
                        </StackPanel></TabItem>
                        <TabItem Header="Обновления и данные"><StackPanel>
<Border Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Обновление программы" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding CurrentAppVersion}" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" />
                                        <Button Content="Проверить обновление" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                        <Expander Header="Токен для закрытого репозитория" Margin="0,16,0,0">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Для открытого репозитория токен не нужен. Если доступ к нему будет закрыт, добавь токен GitHub с правом Contents: Read." Style="{StaticResource Hint}" Margin="0,0,0,9" />
                                                <PasswordBox x:Name="GithubTokenBox" MinHeight="38" Padding="10,7" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Border}" ToolTip="Токен GitHub с доступом Contents: Read только к этому репозиторию" />
                                                <WrapPanel Margin="0,9,0,0">
                                                    <Button Content="Сохранить токен" Click="SaveGithubToken_Click" Margin="0,0,8,0" />
                                                    <Button Content="Удалить токен" Command="{Binding ClearGithubTokenCommand}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding GithubTokenStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
<Border Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <TextBlock Text="Личные данные" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Флот, рейсы и настройки сохраняются автоматически на этом компьютере." Style="{StaticResource Hint}" />
                                <TextBlock Text="Ежедневные резервные копии базы создаются автоматически и хранятся семь дней." Style="{StaticResource Hint}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding DataDirectory}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,16" />
                                <WrapPanel>
                                    <Button Content="Резервная копия" Command="{Binding BackupDataCommand}" Margin="0,0,10,8" />
                                    <Button Content="Открыть папку данных" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Text="Резервная копия содержит всю базу. Для переноса закрой приложение и замени nexus.db в папке данных сохранённой копией." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel></TabItem>
                    </TabControl>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WorkspaceStatus}" FontSize="12" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceStatus}" />
                    <TextBlock Grid.Column="1" Text="{Binding DataStatus}" Style="{StaticResource Hint}" Margin="18,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
