                                <TextBlock Text="Резервная копия содержит всю базу. Для переноса закрой приложение и замени nexus.db в папке данных сохранённой копией." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#101925" BorderBrush="#24303F" BorderThickness="0,1,0,0" Padding="28,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WorkspaceStatus}" FontSize="12" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceStatus}" />
                    <TextBlock Grid.Column="1" Text="{Binding DataStatus}" Style="{StaticResource Hint}" Margin="18,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
