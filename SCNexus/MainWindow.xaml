                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="Источники данных" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding DataSources}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NameDisplay}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding SourceDisplay}" Foreground="{StaticResource Accent}" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusDisplay}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="{Binding LastSuccessDisplay}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Сохранить отчёт" Command="{Binding ExportDiagnosticsCommand}" />
                            <TextBlock Text="Проверка компьютера и установки" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding GameHealthFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,16">
                            <Expander Header="История игровых сессий">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{Binding SessionStatus}" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding GameSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DateDisplay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding ServerDisplay}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Подключение к Star Citizen" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Установка игры" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ResolvedGameDirectory}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <WrapPanel Visibility="{Binding NeedsManualGamePath, Converter={StaticResource BoolVisibility}}">
                                            <Button Content="Выбрать папку игры" Command="{Binding ChooseGameFolderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" />
                                            <Button Content="Найти автоматически" Command="{Binding AutoDetectGameCommand}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Text="Ручной выбор нужен только если установка не найдена автоматически." Style="{StaticResource Hint}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Автоматический мониторинг" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Game.log отслеживается постоянно" FontWeight="SemiBold" />
                                        <TextBlock Text="Nexus читает только новые строки журнала. Частота API и OCR регулируется автоматически, чтобы не создавать лишнюю нагрузку." Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DataCollectionStatus}" Foreground="{StaticResource Accent}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Данные и автоматизация" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Язык" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="180" HorizontalAlignment="Left" Margin="0,5,0,14" />
                                        <CheckBox IsChecked="{Binding OcrEnabled}">
                                            <TextBlock Text="Использовать OCR, когда данных нет в журнале и API" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="OCR экрана работает только когда окно Star Citizen находится на переднем плане. Снимок удаляется сразу после распознавания." Style="{StaticResource Hint}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Отображение" Style="{StaticResource SectionTitle}" />
                                        <CheckBox IsChecked="{Binding ShowRouteDetails}">
                                            <TextBlock Text="Подробности торговых маршрутов" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="Показывать цены за SCU, запас и спрос в каждой карточке." Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                        <TextBlock Text="Крестик сворачивает SC NEXUS в трей. Для полного выхода используй меню значка в области уведомлений." Style="{StaticResource Hint}" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Игровой оверлей" Style="{StaticResource SectionTitle}" />
                                        <CheckBox IsChecked="{Binding OverlayEnabled}">
                                            <TextBlock Text="Показывать оверлей при запущенном Star Citizen" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding OverlayExpanded}">
                                            <TextBlock Text="Расширенный вид: миссия, следующая остановка и свежесть данных" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="Бинд показать / скрыть" Style="{StaticResource FieldLabel}" Margin="0,10,0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button x:Name="OverlayHotkeyCaptureButton" Content="{Binding OverlayHotkeyCaptureText}"
                                                    Style="{StaticResource HotkeyCaptureButton}" Click="BeginOverlayHotkeyCapture_Click"
                                                    PreviewKeyDown="OverlayHotkeyCapture_PreviewKeyDown"
                                                    LostKeyboardFocus="OverlayHotkeyCapture_LostKeyboardFocus" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Очистить" Click="ClearOverlayHotkey_Click" />
                                        </Grid>
                                        <TextBlock Text="{Binding OverlayHotkeyStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="Можно нажать любую свободную комбинацию клавиатуры. Escape отменяет запись, Delete очищает бинд." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                        <Grid Margin="0,10,0,2">
                                            <TextBlock Text="Прозрачность" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <TextBlock Text="{Binding OverlayOpacityDisplay}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Minimum="0.65" Maximum="1" Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="{Binding OverlayPreviewButtonText}" Command="{Binding ToggleOverlayPreviewCommand}" Margin="0,0,8,0" />
                                            <Button Content="{Binding OverlayModeDisplay}" Command="{Binding ToggleOverlayModeCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="Оверлей — отдельное окно только для чтения. Можно назначить любое свободное сочетание; по умолчанию бинда нет. Nexus не внедряется в Star Citizen и не перехватывает управление." Style="{StaticResource Hint}" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Обновление программы" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding CurrentAppVersion}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                                        <Button Content="Проверить обновление" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                        <Expander Header="Токен для закрытого репозитория" Margin="0,16,0,0">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Для открытого репозитория токен не нужен. Если доступ к нему будет закрыт, добавь токен GitHub с правом Contents: Read." Style="{StaticResource Hint}" Margin="0,0,0,9" />
                                                <PasswordBox x:Name="GithubTokenBox" MinHeight="38" Padding="10,7" Background="#0F1825" Foreground="White" BorderBrush="#324052" ToolTip="Токен GitHub с доступом Contents: Read только к этому репозиторию" />
                                                <WrapPanel Margin="0,9,0,0">
                                                    <Button Content="Сохранить токен" Click="SaveGithubToken_Click" Margin="0,0,8,0" />
                                                    <Button Content="Удалить токен" Command="{Binding ClearGithubTokenCommand}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding GithubTokenStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Личные данные" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Флот, рейсы и настройки сохраняются автоматически на этом компьютере." Style="{StaticResource Hint}" />
                                <TextBlock Text="Ежедневные резервные копии базы создаются автоматически и хранятся семь дней." Style="{StaticResource Hint}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding DataDirectory}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,16" />
                                <WrapPanel>
                                    <Button Content="Резервная копия" Command="{Binding BackupDataCommand}" Margin="0,0,10,8" />
                                    <Button Content="Открыть папку данных" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Text="Резервная копия содержит всю базу. Для переноса закрой приложение и замени nexus.db в папке данных сохранённой копией." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#101925" BorderBrush="#24303F" BorderThickness="0,1,0,0" Padding="28,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WorkspaceStatus}" FontSize="12" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceStatus}" />
                    <TextBlock Grid.Column="1" Text="{Binding DataStatus}" Style="{StaticResource Hint}" Margin="18,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
