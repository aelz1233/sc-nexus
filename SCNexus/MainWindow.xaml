<Window x:Class="SCNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC NEXUS" Width="1320" Height="820" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="14,14,0,14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0D1923" BorderBrush="#29404E" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,28,20,20">
                <TextBlock DockPanel.Dock="Bottom" Text="UEX LIVE  •  LOCAL CACHE" Foreground="{StaticResource Muted}" FontSize="11"/>
                <StackPanel>
                    <TextBlock Text="SC NEXUS" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="PERSONAL COMPANION" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,2,0,36"/>
                    <Button Style="{StaticResource Nav}" Content="DASHBOARD" Command="{Binding OpenDashboardCommand}" Foreground="{StaticResource Accent}"/>
                    <TextBlock Style="{StaticResource NavPlaceholder}" Text="TRADING"/>
                    <TextBlock Style="{StaticResource NavPlaceholder}" Text="ROUTES"/>
                    <Button Style="{StaticResource Nav}" Content="FLEET" Command="{Binding OpenFleetCommand}" Foreground="{StaticResource Accent}"/>
                    <TextBlock Style="{StaticResource NavPlaceholder}" Text="LOADOUT"/>
                    <TextBlock Style="{StaticResource NavPlaceholder}" Text="SALVAGE"/>
                    <TextBlock Style="{StaticResource NavPlaceholder}" Text="MINING"/>
                    <Button Style="{StaticResource Nav}" Content="HISTORY" Command="{Binding OpenHistoryCommand}" Foreground="{StaticResource Accent}"/>
                    <Button Style="{StaticResource Nav}" Content="SETTINGS" Command="{Binding OpenSettingsCommand}" Foreground="{StaticResource Accent}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="34,28,34,34">
                <StackPanel Visibility="{Binding IsDashboardOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="COMMAND DECK  /  ЛИЧНЫЙ ОБЗОР" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Твой следующий рейс начинается здесь." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,22"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource Caption}" Text="БАЛАНС"/><TextBlock Text="{Binding BalanceDisplay}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ"/><TextBlock Text="{Binding CurrentShip}" FontSize="20" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ЛОКАЦИЯ"/><TextBlock Text="{Binding CurrentLocation}" FontSize="20" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="РЕАЛЬНЫЕ РЕЙСЫ"/><TextBlock Text="{Binding TotalFlightProfitDisplay}" FontSize="19" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ЛИЧНЫЙ PROFIT / HOUR"/><TextBlock Text="{Binding PersonalProfitHourDisplay}" FontSize="19" Margin="0,8,0,0"/></StackPanel></Border>
                    </Grid>
                    <Button Command="{Binding RecommendCommand}" Background="{StaticResource Accent}" Foreground="#07151A" FontSize="22" FontWeight="Bold" Padding="26,22" Content="ЧТО МНЕ ДЕЛАТЬ СЕЙЧАС?"/>
                    <TextBlock Text="{Binding DataStatus}" Foreground="{StaticResource Accent}" Margin="0,12,0,20"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="ТОРГОВЫЕ МАРШРУТЫ" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding RecommendationMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="ТОП МАРШРУТОВ ОТ ТЕКУЩЕЙ ЛОКАЦИИ" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Commodity}" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding ScuDisplay}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="BUY"/><TextBlock Text="{Binding BuyAt}" TextWrapping="Wrap" Margin="0,5,12,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="SELL"/><TextBlock Text="{Binding SellAt}" TextWrapping="Wrap" Margin="0,5,12,0"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Caption}" Text="ЧИСТЫМИ"/><TextBlock Text="{Binding ProfitDisplay}" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <TextBlock Text="Закупка: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding InvestmentDisplay}"/>
                                        <TextBlock Text="    ROI: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding RoiDisplay}"/>
                                        <TextBlock Text="    " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding FreshnessDisplay}"/>
                                        <TextBlock Text="    " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding RiskDisplay}"/>
                                        <TextBlock Text="    " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding PersonalDurationDisplay}"/>
                                    </StackPanel>
                                    <Button Content="НАЧАТЬ ЭТОТ РЕЙС" Command="{Binding DataContext.PrepareFlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,15,0,0" Padding="16,8"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Данные UEX поддерживаются игроками. Объёмы — последние сообщения/прогноз спроса; наличие и время рейса не гарантированы." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsFleetOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="FLEET  /  МОИ КОРАБЛИ" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Мой флот" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <TextBlock Text="Добавь свои корабли. Доход каждого считается по завершённым рейсам." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="ДОБАВИТЬ КОРАБЛЬ" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,14"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="НАЗВАНИЕ"/><TextBox Text="{Binding NewShipName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Style="{StaticResource Caption}" Text="CARGO SCU"/><TextBox Text="{Binding NewShipCargoScu, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="РОЛЬ"/><TextBox Text="{Binding NewShipRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩИЙ БИЛД / ЗАМЕТКИ" Margin="0,16,0,0"/>
                            <TextBox Text="{Binding NewShipBuild, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
                            <Button Content="ДОБАВИТЬ В МОЙ ФЛОТ" Command="{Binding AddShipCommand}" HorizontalAlignment="Left" Background="{StaticResource Accent}" Foreground="#07151A" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Ships}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="ГРУЗ"/><TextBlock Text="{Binding CargoDisplay}" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ЗАРАБОТАЛ"/><TextBlock Text="{Binding EarnedDisplay}" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding BuildNotes}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="ИСПОЛЬЗОВАТЬ" Command="{Binding DataContext.UseShipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                <Button Content="УДАЛИТЬ" Command="{Binding DataContext.DeleteShipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding FlightStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="HISTORY  /  РЕАЛЬНЫЕ РЕЙСЫ" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Трекер рейсов" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <TextBlock Text="{Binding ActiveFlightDisplay}" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                        <TextBlock Text="МАРШРУТ И ФАКТИЧЕСКИЕ СУММЫ" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Корабль берётся из раздела FLEET. При завершении прибыль добавится к балансу." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ОТКУДА"/><TextBox Text="{Binding FlightOrigin, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="КУДА"/><TextBox Text="{Binding FlightDestination, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="ТОВАР"/><TextBox Text="{Binding FlightCommodity, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ВЛОЖЕНО"/><TextBox Text="{Binding FlightInvestment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="ПОЛУЧЕНО"/><TextBox Text="{Binding FlightRevenue, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="РАСХОДЫ"/><TextBox Text="{Binding FlightExpenses, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Caption}" Text="ПОТЕРИ"/><TextBox Text="{Binding FlightLosses, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="НАЧАТЬ РЕЙС" Command="{Binding StartFlightCommand}" Margin="0,0,10,0" Background="{StaticResource Accent}" Foreground="#07151A" FontWeight="Bold"/><Button Content="ЗАВЕРШИТЬ РЕЙС" Command="{Binding FinishFlightCommand}" IsEnabled="{Binding HasActiveFlight}"/></StackPanel>
                        <TextBlock Text="{Binding FlightStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="ИСТОРИЯ" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Flights}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding DateDisplay}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ShipName}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Commodity}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Origin}"/><TextBlock Text=" → "/><TextBlock Text="{Binding Destination}"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding ProfitDisplay}" FontWeight="Bold"/><TextBlock Text="{Binding DurationDisplay}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Вложено: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Investment, StringFormat={}{0:N0} aUEC}"/><TextBlock Text="    Получено: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Revenue, StringFormat={}{0:N0} aUEC}"/><TextBlock Text="    Расходы и потери: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Expenses, StringFormat={}{0:N0}}"/><TextBlock Text=" + "/><TextBlock Text="{Binding Losses, StringFormat={}{0:N0} aUEC}"/></StackPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <Border Background="#F0091118" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="МОИ НАСТРОЙКИ" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Изменения сохраняются автоматически на этом компьютере." Foreground="{StaticResource Muted}" Margin="0,0,0,28"/>
                        <TextBlock Style="{StaticResource Caption}" Text="БАЛАНС aUEC"/>
                        <TextBox Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩИЙ КОРАБЛЬ"/>
                        <TextBox Text="{Binding CurrentShip, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩАЯ ЛОКАЦИЯ"/>
                        <TextBox Text="{Binding CurrentLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="ВМЕСТИМОСТЬ КОРАБЛЯ, SCU"/>
                        <TextBox Text="{Binding CargoScu, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <TextBlock Style="{StaticResource Caption}" Text="НЕ ТРАТИТЬ ПОСЛЕДНИЕ, aUEC"/>
                        <TextBox Text="{Binding Reserve, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,7,0,18"/>
                        <CheckBox Content="Показывать NQA / рискованные терминалы" IsChecked="{Binding AllowRisky}" Foreground="White" Margin="0,0,0,18"/>
                        <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource Accent}" Margin="0,0,0,24"/>
                        <Button Content="ГОТОВО" Command="{Binding OpenDashboardCommand}" Background="{StaticResource Accent}" Foreground="#07151A" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
