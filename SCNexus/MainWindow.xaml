<Window x:Class="SCNexus.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCNexus.Controls" Title="SC NEXUS" Icon="Assets/sc-nexus.ico" Width="1320" Height="880" MinWidth="1000" MinHeight="650" Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#0E1722" BorderBrush="#24303F" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,28,14,30">
                    <Image Source="Assets/sc-nexus.png" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="SC NEXUS" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="ЛИЧНЫЙ КОМПАНЬОН" FontSize="9" Foreground="{StaticResource Accent}" Margin="1,7,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="22,20">
                    <TextBlock Text="НА ЭТОМ КОМПЬЮТЕРЕ" FontSize="9" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenDashboardCommand}" Tag="{Binding IsDashboardOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Обзор" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenHaulingCommand}" Tag="{Binding IsHaulingOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Маршруты" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenFleetCommand}" Tag="{Binding IsFleetOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Флот" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenHistoryCommand}" Tag="{Binding IsHistoryOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Рейсы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenToolsCommand}" Tag="{Binding IsToolsOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Инструменты" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}" Tag="{Binding IsSettingsOpen}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0" />
                            <TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Bg}" BorderBrush="#24303F" BorderThickness="0,0,0,1" Padding="28,23,28,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ActivePage}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding CurrentShip}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding BalanceDisplay}" Style="{StaticResource Hint}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True" Padding="28,24,28,28">
                <Grid MaxWidth="1440" HorizontalAlignment="Stretch">
                    <StackPanel Visibility="{Binding IsDashboardOpen, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource Card}" Background="#14282D" BorderBrush="#2E5D59" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Готов к следующему рейсу?" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TradeBudgetHint}" Foreground="#B1D5CE" Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding CurrentShip, StringFormat=Активный корабль: {0}}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Подобрать маршрут  →" Command="{Binding OpenHaulingCommand}" VerticalAlignment="Center" Margin="18,0,0,0" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Заработано сегодня" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding TodayProfitDisplay}" FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="За завершённые рейсы" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding TotalFlightProfitDisplay}" FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Средняя прибыль в час" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding PersonalProfitHourDisplay}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasActiveFlight, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Рейс в процессе" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding ActiveFlightDisplay}" TextWrapping="Wrap" />
                                <Button Content="Продолжить рейс" Command="{Binding OpenHistoryCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasNoShips, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Добавь первый корабль" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Выбери модель из каталога. Вместимость и роль заполнятся автоматически." Style="{StaticResource Hint}" />
                                <Button Content="Открыть флот" Command="{Binding OpenFleetCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Флот" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding FleetSummary}" />
                                    <TextBlock Text="{Binding CurrentShip, StringFormat=Выбран: {0}}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                    <Button Content="Управлять кораблями" Command="{Binding OpenFleetCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Star Citizen" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding GameProcessStatus}" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="{Binding ResolvedGameDirectory}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                    <Button Content="Проверить игру" Command="{Binding OpenToolsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsHaulingOpen, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Параметры рейса" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,15" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="КОРАБЛЬ" />
                                        <ComboBox ItemsSource="{Binding SortedShips}" SelectedItem="{Binding SelectedShip, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" Visibility="{Binding IsDirectVoyage, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Style="{StaticResource Caption}" Text="СОРТИРОВКА" />
                                        <ComboBox ItemsSource="{Binding HaulingSortOptions}" SelectedItem="{Binding HaulingSortMode, Mode=TwoWay}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Caption}" Text="ТРЮМ" />
                                        <TextBlock Text="{Binding SelectedShip.Ship.CargoScu, StringFormat={}{0:N0} SCU}" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Баланс, aUEC" />
                                        <TextBox>
                                            <TextBox.Text>
                                                <Binding Path="Balance" UpdateSourceTrigger="LostFocus" Converter="{StaticResource MoneyConverter}">
                                                    <Binding.ValidationRules>
                                                        <ui:MoneyRule />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Денежный резерв, aUEC" />
                                        <TextBox>
                                            <TextBox.Text>
                                                <Binding Path="Reserve" UpdateSourceTrigger="LostFocus" Converter="{StaticResource MoneyConverter}">
                                                    <Binding.ValidationRules>
                                                        <ui:MoneyRule />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#0C1520" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Любая локация" Command="{Binding ClearLocationCommand}" Padding="10,5" />
                                            <TextBlock Text="{Binding HaulingStartDisplay, StringFormat=Старт: {0}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" Margin="0,0,12,0" />
                                            <TextBox Grid.Column="1" Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Введи минимум две буквы и выбери стартовую точку" />
                                        </Grid>
                                        <TextBlock Text="{Binding LocationStatus}" Style="{StaticResource Hint}" Margin="0,7,0,0" />
                                        <ItemsControl ItemsSource="{Binding FilteredLocations}" Visibility="{Binding ShowLocationSuggestions, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Display}" Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Background="#182735" Margin="0,2" Padding="10,7" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Expander Header="Фильтры и ограничения" Margin="0,16,0,12">
                                    <StackPanel>
                                        <StackPanel Margin="0,15,0,0">
                                            <TextBlock Style="{StaticResource Caption}" Text="ТИП МАРШРУТА" />
                                            <ComboBox ItemsSource="{Binding HaulingCategories}" SelectedItem="{Binding HaulingCategory, Mode=TwoWay}" Width="210" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <CheckBox Content="Только рейсы внутри одной системы" IsChecked="{Binding HaulingSameSystemOnly, Mode=TwoWay}" Foreground="White" Margin="0,16,0,9" />
                                        <CheckBox Content="Включить терминалы NQA" IsChecked="{Binding AllowRisky, Mode=TwoWay}" Foreground="White" Margin="0,0,0,9" />
                                        <CheckBox Content="Исключить Pyro" IsChecked="{Binding AvoidPyro, Mode=TwoWay}" Foreground="White" Margin="0,0,0,12" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Caption}" Text="Минимум заполнения, %" />
                                                <ComboBox ItemsSource="{Binding MinimumFillOptions}" SelectedItem="{Binding MinimumFillPercent, Mode=TwoWay}" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource Caption}" Text="Минимум прибыли, aUEC" />
                                                <TextBox Margin="0,6,0,0">
                                                    <TextBox.Text>
                                                        <Binding Path="MinimumProfit" UpdateSourceTrigger="LostFocus" Converter="{StaticResource MoneyConverter}">
                                                            <Binding.ValidationRules>
                                                                <ui:MoneyRule />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="Сбросить фильтры" Command="{Binding ResetRouteFiltersCommand}" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource Muted}" Padding="0,8" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Режим планирования" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VoyageModes}" SelectedItem="{Binding VoyageMode}" Margin="0,0,0,12" />
                                <Border Background="#0C1520" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding VoyageHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="22" />
                                </Border>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Все" Command="{Binding SelectAllRouteSystemsCommand}" Padding="10,5" Margin="0,0,6,0" />
                                        <Button Content="Снять выбор" Command="{Binding ClearRouteSystemsCommand}" Padding="10,5" />
                                    </StackPanel>
                                    <TextBlock Text="Системы маршрута" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding RouteSystems}" Margin="0,4,0,8">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="#EAF0F6" Margin="0,0,22,6" Padding="4,2" />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RouteSystemsSummary}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <StackPanel Visibility="{Binding IsMultiVoyage, Converter={StaticResource BoolVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="До точек закупки" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding VoyageStopLimits}" SelectedItem="{Binding VoyageMaxPurchases}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Конечная точка · поиск по системе и названию" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding VoyageDestinationQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: Stanton или Tressler" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding VoyageDestinations}" SelectedItem="{Binding VoyageDestination}" DisplayMemberPath="Display" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Используются стартовая точка и фильтры выше. Для цепочки минимум заполнения применяется к каждому участку. Подбор предлагает выгодные варианты, но не гарантирует кратчайший или самый прибыльный путь." TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,12,0,12" />
                                    <Button Content="Подобрать рейсы" Command="{Binding BuildVoyagesCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                </StackPanel>
                                <TextBlock Text="{Binding HaulingBudgetDisplay, StringFormat=Доступно на закупку с учётом резерва: {0}}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding HaulingStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Обновить цены" Command="{Binding RefreshMarketCommand}" />
                            <TextBlock Text="Подходящие маршруты" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsMarketLoading, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" />
                        <StackPanel Visibility="{Binding IsMultiVoyage, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding VoyageStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsVoyageLoading, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding VoyagePlans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProfitDisplay}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding PathDisplay}" TextWrapping="Wrap" Margin="0,10,0,8" />
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                                <ProgressBar Value="{Binding FillPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,10" />
                                                <TextBlock Text="{Binding RiskDisplay}" Foreground="#FFBD8F" />
                                                <TextBlock Text="{Binding QuoteDisplay}" Style="{StaticResource Hint}" Margin="0,6,0,10" />
                                                <Expander Header="Остановки и груз" IsExpanded="True">
                                                    <ItemsControl ItemsSource="{Binding Stops}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#0C1520" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                                        <TextBlock Text="⚠ ОПАСНО: Pyro" Foreground="#FF9A8F" Visibility="{Binding IsPyro, Converter={StaticResource BoolVisibility}}" Margin="0,5,0,0" />
                                                                        <TextBlock Text="{Binding Action}" TextWrapping="Wrap" Margin="0,8,0,6" />
                                                                        <TextBlock Text="{Binding LoadDisplay}" Foreground="{StaticResource Muted}" />
                                                                        <TextBlock Text="{Binding CashDisplay}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <WrapPanel Margin="0,14,0,0">
                                                    <Button Content="Перенести в рейс" Command="{Binding DataContext.PrepareVoyageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,10,0" />
                                                    <Button Content="Сохранить план в файл" Command="{Binding DataContext.ExportVoyageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding HaulingRoutes}" Visibility="{Binding IsDirectVoyage, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Commodity}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                                    <TextBlock Text="{Binding RouteDisplay}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                    <TextBlock Text="{Binding ProfitDisplay}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ProfitPerScuDisplay}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel Margin="0,13,0,0">
                                                <TextBlock Text="{Binding CategoryDisplay}" Foreground="#9DBBFF" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding CargoDisplay}" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding RoiDisplay}" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding RiskDisplay}" Foreground="{Binding RiskColor}" FontWeight="SemiBold" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,7,0,0">
                                                <TextBlock Text="{Binding InvestmentDisplay, StringFormat=Закупка: {0}}" Foreground="{StaticResource Muted}" Margin="0,0,16,0" />
                                                <TextBlock Visibility="{Binding DataContext.ShowRouteDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" Text="{Binding AvailabilityDisplay}" Foreground="{StaticResource Muted}" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding UpdatedDisplay}" Foreground="{StaticResource Muted}" />
                                            </WrapPanel>
                                            <ProgressBar Value="{Binding FillPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,0" />
