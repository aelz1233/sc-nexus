<UserControl x:Class="SCNexus.Controls.ShipConfiguratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <DataTemplate x:Key="ComponentLineTemplate">
            <Border Background="#0C1621" BorderBrush="#22364A" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SlotDisplay}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding NameDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetricDisplay}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PriceDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ShopDisplay}" Style="{StaticResource Hint}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdatedDisplay}" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShoppingPlanTemplate">
            <Border Background="#0C1621" BorderBrush="#22364A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,7">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NameDisplay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" FontWeight="SemiBold" Margin="16,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding LogicDisplay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <Expander Header="Остановки и список покупок" IsExpanded="False" Margin="0,7,0,0">
                        <ItemsControl ItemsSource="{Binding Stops}" Margin="0,7,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111E2B" CornerRadius="7" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="⚠ ОПАСНО: Pyro" Foreground="#FF9A8F" Visibility="{Binding IsPyro, Converter={StaticResource BoolVisibility}}" Margin="0,3,0,0" />
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,5,0,0">
                                                <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CostDisplay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BuildResultTemplate">
            <StackPanel Margin="0,12,0,0">
                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CostDisplay}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding CoverageDisplay}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Копировать детали" Click="OnCopyBuildClick" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
                <Border Background="#0D1925" BorderBrush="#22364A" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,9">
                    <StackPanel>
                        <TextBlock Text="{Binding ComparisonDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EngineeringComparisonDisplay}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding QuantumDisplay}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Expander Header="Маршрут покупки" IsExpanded="True" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding ShoppingPlans}" ItemTemplate="{StaticResource ShoppingPlanTemplate}" Margin="0,8,0,0" />
                </Expander>
                <Expander Header="Все компоненты" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding ChangesDisplay}" Style="{StaticResource Hint}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource ComponentLineTemplate}" />
                        <TextBlock Text="{Binding EngineeringDisplay}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding EngineeringStatus}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="КОРАБЛЬ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ShipPicker" DisplayMemberPath="Name" SelectionChanged="OnShipSelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="БЮДЖЕТ, aUEC" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="BudgetBox" Text="0" HorizontalContentAlignment="Right" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ПРИОРИТЕТ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProfilePicker" SelectedIndex="0">
                            <ComboBoxItem Content="Бой" />
                            <ComboBoxItem Content="Путешествие и торговля" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="BuildButton" Content="Рассчитать" Style="{StaticResource PrimaryButton}" Click="OnBuildClick" Margin="0,0,8,0" />
                    <Button x:Name="UseBalanceButton" Grid.Column="1" Content="Доступный баланс" Click="OnUseBalanceClick" />
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="Выбери корабль и рассчитай конфигурации." Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Expander x:Name="SummaryCard" Header="Данные и метод расчёта" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,10">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,7,0,0">
                <StackPanel>
                    <TextBlock x:Name="DataStatusText" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CoverageText" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                    <TextBlock x:Name="MethodText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}">
                        <Run Text="Источники: " />
                        <Hyperlink NavigateUri="https://api.star-citizen.wiki/developers" RequestNavigate="OnSourceNavigate" Foreground="{StaticResource Accent}">Star Citizen Wiki API</Hyperlink>
                        <Run Text=" и UEX Corp." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Expander>

        <TabControl x:Name="ResultsTabs" Visibility="Collapsed">
            <TabItem x:Name="BudgetTab" Header="Лучшее за бюджет">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BuildResultTemplate}" />
            </TabItem>
            <TabItem x:Name="BestTab" Header="Максимальная конфигурация">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BuildResultTemplate}" />
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
