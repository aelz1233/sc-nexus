<UserControl x:Class="SCNexus.Controls.RouteResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCNexus.Controls" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <ui:CommodityImageConverter x:Key="CommodityImage" />
        <Style x:Key="NumberCell" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
        <Style x:Key="TextCell" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="360"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding RouteSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Товар или точка" AutomationProperties.Name="Поиск: товар или точка" Width="240"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DataStatus}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0"/>
            <Button Grid.Column="2" Content="Обновить цены" Command="{Binding RefreshMarketCommand}" VerticalAlignment="Center"/>
            <CheckBox x:Name="InspectorToggle" Grid.Column="3" Content="Подробности" IsChecked="{Binding ShowRouteInspector}" Checked="OnInspectorChanged" Unchecked="OnInspectorChanged" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Border VerticalAlignment="Top" CornerRadius="8" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="1" ClipToBounds="True">
            <DataGrid x:Name="Results" ItemsSource="{Binding RouteResults, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedRouteResult, Mode=TwoWay}" SelectionChanged="OnSelectionChanged" Sorting="OnSorting" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="True" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="540" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Border}" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8,12"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/><Path x:Name="SortArrow" Grid.Column="1" Data="M0,0 L6,0 L3,4 Z" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                    <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
                    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="58"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers></Style>
                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></Style.Triggers></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Рейс" SortMemberPath="Commodity" Width="*" MinWidth="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="12,6" VerticalAlignment="Center"><TextBlock Text="{Binding Commodity}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Commodity}"/><TextBlock Text="{Binding RoutePath}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding RoutePath}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn HeaderStyle="{StaticResource NumericHeader}" Header="Инвестиции" SortMemberPath="Investment" Binding="{Binding Investment, StringFormat=N0}" Width="130" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTextColumn HeaderStyle="{StaticResource NumericHeader}" Header="Прибыль" SortMemberPath="Profit" Binding="{Binding Profit, StringFormat=N0}" Width="130" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTextColumn HeaderStyle="{StaticResource NumericHeader}" Header="Маржа, %" SortMemberPath="MarginPercent" Binding="{Binding MarginPercent, StringFormat={}{0:N1}%}" Width="105" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTemplateColumn Header="Риск" SortMemberPath="RiskRank" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,6" VerticalAlignment="Center"><TextBlock Text="{Binding RiskTitle}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsDangerous}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding IsNqaRisk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding RiskDetail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding HasRiskDetail, Converter={StaticResource BoolVisibility}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Border>
            <Border Background="{DynamicResource Panel}" Margin="1,45,1,1" Visibility="{Binding NoRouteResults, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><TextBlock Text="Нет подходящих маршрутов. Проверь поиск, бюджет и фильтры." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/></Border>
        </Grid>
        <Border x:Name="Details" Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="20,0,0,0" Visibility="{Binding HasRouteSelection, Converter={StaticResource BoolVisibility}}">
            <StackPanel DataContext="{Binding SelectedRouteResult}">
                <TextBlock Text="ВЫБРАННЫЙ РЕЙС" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal"><Image Source="{Binding Commodity, Converter={StaticResource CommodityImage}}" Width="40" Height="42" Margin="0,0,12,0"/><TextBlock Text="{Binding Commodity}" FontWeight="SemiBold" FontSize="19" TextWrapping="Wrap" MaxWidth="255" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="{Binding RoutePath}" Style="{StaticResource Hint}" Margin="0,8,0,3"/>
                <TextBlock Text="{Binding Systems}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding RiskTitle}" FontWeight="SemiBold" Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsDangerous}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding IsNqaRisk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Закупка" Style="{StaticResource Hint}"/><TextBlock Grid.Column="1" Text="{Binding Investment, StringFormat={}{0:N0} aUEC}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Grid.Row="1" Text="Выручка" Style="{StaticResource Hint}" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Revenue, StringFormat={}{0:N0} aUEC}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,5,0,0"/>
                        <TextBlock Grid.Row="2" Text="Прибыль" Style="{StaticResource Hint}" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Profit, StringFormat={}{0:N0} aUEC}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Grid.Row="3" Text="Загрузка" Style="{StaticResource Hint}" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Load}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,5,0,0"/>
                    </Grid>
                </Border>
                <ProgressBar Value="{Binding FillPercent, Mode=OneWay}" Maximum="100" Margin="0,0,0,10"/>
                <Button Content="Выбрать рейс" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.UseSelectedRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,2,0,12"/>
                <TextBlock Text="Остановки" FontWeight="SemiBold" Margin="0,2,0,8"/>
                <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Stops}" TextWrapping="Wrap" LineHeight="21"/></ScrollViewer>
                <TextBlock Text="{Binding CostsNote}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                <Expander Header="Груз и цены" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding Trades}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Commodity}" FontWeight="SemiBold"/><TextBlock Text="{Binding BuyPrice, StringFormat=Покупка: {0:N0} / SCU}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding SellPrice, StringFormat=Продажа: {0:N0} / SCU}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding AvailabilityDisplay}" Style="{StaticResource Hint}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                <TextBlock Text="{Binding Freshness}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
