<UserControl x:Class="SCNexus.Controls.RouteResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCNexus.Controls" MinHeight="380" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <ui:CommodityImageConverter x:Key="CommodityImage" />
        <Style x:Key="NumberCell" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
        <Style x:Key="TextCell" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="300"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <CheckBox x:Name="InspectorToggle" DockPanel.Dock="Right" Content="Подробности" IsChecked="{Binding ShowRouteInspector}" Checked="OnInspectorChanged" Unchecked="OnInspectorChanged" Margin="12,0,0,0"/><Button DockPanel.Dock="Right" Content="Обновить цены" Command="{Binding RefreshMarketCommand}" Margin="12,0,0,0"/><TextBlock Text="Поиск маршрута" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Text="{Binding RouteSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Товар, локация или система" AutomationProperties.Name="Поиск маршрута" MaxWidth="420" HorizontalAlignment="Left" Width="300"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Border VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="1" ClipToBounds="True">
            <DataGrid x:Name="Results" ItemsSource="{Binding RouteResults, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedRouteResult, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" Height="380" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Border}" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border}" RowBackground="{DynamicResource Panel}" AlternatingRowBackground="{DynamicResource Panel}" Sorting="OnSorting">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8,12"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/><Path x:Name="SortArrow" Grid.Column="1" Data="M0,0 L6,0 L3,4 Z" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                    <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
                    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="64"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger></Style.Triggers></Style>
                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Товар" SortMemberPath="Commodity" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8"><Image Source="{Binding Commodity, Converter={StaticResource CommodityImage}}" Width="32" Height="36" Margin="0,0,8,0"/><TextBlock Text="{Binding Commodity}" Width="96" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Commodity}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Откуда" SortMemberPath="Origin" Width="*" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8" VerticalAlignment="Center"><TextBlock Text="{Binding Origin}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Origin}"/><TextBlock Text="{Binding Systems}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Risk}" Foreground="{DynamicResource Danger}" Visibility="{Binding IsDangerous, Converter={StaticResource BoolVisibility}}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Куда" Binding="{Binding Destination}" SortMemberPath="Destination" Width="*" MinWidth="140" ElementStyle="{StaticResource TextCell}"/>
                    <DataGridTextColumn HeaderStyle="{StaticResource NumericHeader}" Header="SCU" Binding="{Binding Load}" SortMemberPath="Cargo" Width="100" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTextColumn HeaderStyle="{StaticResource NumericHeader}" Header="Закупка" Binding="{Binding Investment, StringFormat=N0}" SortMemberPath="Investment" Width="115" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTextColumn HeaderStyle="{StaticResource NumericHeader}" Header="Прибыль" Binding="{Binding Profit, StringFormat=N0}" SortMemberPath="Profit" Width="115" ElementStyle="{StaticResource NumberCell}"/>
                </DataGrid.Columns>
            </DataGrid>
            </Border>
            <Border Background="{DynamicResource Panel}" Margin="1,45,1,1" Visibility="{Binding NoRouteResults, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><TextBlock Text="Нет подходящих маршрутов. Проверь поиск, бюджет и фильтры." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/></Border>
        </Grid>
        <Border x:Name="Details" Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="16,0,0,0" Visibility="{Binding HasRouteSelection, Converter={StaticResource BoolVisibility}}">
            <StackPanel DataContext="{Binding SelectedRouteResult}">
                <StackPanel Orientation="Horizontal"><Image Source="{Binding Commodity, Converter={StaticResource CommodityImage}}" Width="40" Height="42" Margin="0,0,12,0"/><TextBlock Text="{Binding Commodity}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="{Binding Systems}" Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource Danger}" Visibility="{Binding IsDangerous, Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Закупка" Style="{StaticResource Hint}"/><TextBlock Grid.Column="1" Text="{Binding Investment, StringFormat={}{0:N0} aUEC}" TextAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="Выручка" Style="{StaticResource Hint}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Revenue, StringFormat={}{0:N0} aUEC}" TextAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="Прибыль" Style="{StaticResource Hint}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Profit, StringFormat={}{0:N0} aUEC}" TextAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Text="Загрузка" Style="{StaticResource Hint}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Load}" TextAlignment="Right"/>
                </Grid>
                <ProgressBar Value="{Binding FillPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"/>
                <TextBlock Text="{Binding CostsNote}" Style="{StaticResource Hint}"/>
                <Button Content="Выбрать рейс" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.UseSelectedRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Text="Остановки" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Stops}" TextWrapping="Wrap" LineHeight="21"/></ScrollViewer>
                <Expander Header="Груз и цены" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding Trades}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Commodity}" FontWeight="SemiBold"/><TextBlock Text="{Binding BuyPrice, StringFormat=Покупка: {0:N0} / SCU}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding SellPrice, StringFormat=Продажа: {0:N0} / SCU}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding AvailabilityDisplay}" Style="{StaticResource Hint}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                <TextBlock Text="{Binding Freshness}" Style="{StaticResource Hint}" Margin="0,12,0,8"/>
                
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
