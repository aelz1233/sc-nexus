<Window Foreground="{DynamicResource Text}" x:Class="SCNexus.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False">
    <Viewbox x:Name="OverlayScaleHost" Width="360" Stretch="Uniform" StretchDirection="Both"
             HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border x:Name="OverlayChrome" Width="360" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="12" Padding="14" SnapsToDevicePixels="True">
            <StackPanel x:Name="OverlayContent" Opacity="{Binding OverlayTextOpacity}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="7" Height="7" Background="{DynamicResource Accent}" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="SC NEXUS" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding OverlayBalanceDisplay}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="135" />
                        <Border Background="{DynamicResource Input}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                Visibility="{Binding OverlayDanger, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding OverlayDangerDisplay}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" FontSize="10" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding OverlayShowShip, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                    <TextBlock Text="{Binding OverlayShipDisplay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding OverlayLocationDisplay}" Visibility="{Binding OverlayShowLocation, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{Binding OverlayMissionDisplay}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding OverlayShowMission}" Value="True" />
                                        <Condition Binding="{Binding OverlayHasMission}" Value="True" />
                                        <Condition Binding="{Binding OverlayExpanded}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Visibility="{Binding OverlayShowRoute, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Visibility="{Binding OverlayHasRoute, Converter={StaticResource BoolVisibility}}">
                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,10,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OverlayActionHeading}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Grid.Column="1" Text="{Binding OverlayProfitDisplay}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding OverlayActionDisplay}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding OverlayStopDisplay}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding OverlayNextDisplay}" Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVisibility}}"
                                   Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding HasOverlayChecklist, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                    <TextBlock Text="{Binding OverlayChecklistTitle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding OverlayChecklistSummary}" Style="{StaticResource Hint}" Margin="0,3,0,5" />
                    <ScrollViewer MaxHeight="155" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OverlayChecklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" IsEnabled="{Binding DataContext.OverlayControlsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,3,4,3">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding OverlayControlsEnabled, Converter={StaticResource BoolVisibility}}">
                        <Button Content="← Назад" Command="{Binding PreviousChecklistStopCommand}" Padding="9,5" Margin="0,0,6,0" />
                        <Button Content="Шаг выполнен →" Command="{Binding CompleteChecklistStopCommand}" Padding="9,5" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                        <Button Content="{Binding OverlayChecklistSwitchText}" Command="{Binding SwitchOverlayChecklistCommand}" Visibility="{Binding CanSwitchOverlayChecklist, Converter={StaticResource BoolVisibility}}" Padding="9,5" />
                    </WrapPanel>
                </StackPanel>
                <Button Content="Сканировать терминал" Command="{Binding ScanTradeTerminalCommand}" Visibility="{Binding OverlayControlsEnabled, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0" />
                <TextBlock Text="{Binding TerminalScanStatus}" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />

                <TextBlock Text="{Binding OverlayControlHint}" Visibility="{Binding OverlayEditMode, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding OverlayFreshnessDisplay}" Visibility="{Binding OverlayShowFreshness, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
