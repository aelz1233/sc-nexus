<Window x:Class="SCNexus.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False">
    <Window.Resources>
        <DataTemplate x:Key="OverlayActions">
            <StackPanel Width="426">
                <StackPanel Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVisibility}}">
                <Border Background="#101B27" CornerRadius="7" Padding="10" Margin="0,0,0,8"
                        Visibility="{Binding HasOverlayChecklist, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding OverlayChecklistSwitchText}" Command="{Binding SwitchOverlayChecklistCommand}"
                                    Visibility="{Binding CanSwitchOverlayChecklist, Converter={StaticResource BoolVisibility}}" Padding="6,3" Margin="6,0,0,0" Focusable="False" />
                            <TextBlock Text="{Binding OverlayChecklistTitle}" Foreground="#69CFC0" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding OverlayChecklistStop}" Foreground="#F0F6FC" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="⚠ PYRO" Foreground="#FFD09B" Visibility="{Binding OverlayChecklistDanger, Converter={StaticResource BoolVisibility}}" />
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding OverlayChecklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="0,4" Focusable="False">
                                            <TextBlock Text="{Binding Text}" Foreground="#DCE7F1" FontSize="11" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding OverlayChecklistSummary}" Foreground="#91A5B8" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OverlayChecklistNext}" Foreground="#91A5B8" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Button Content="{Binding OverlayChecklistNextButton}" Command="{Binding CompleteChecklistStopCommand}" Padding="8,4" Margin="0,6,0,0" Focusable="False"
                                Visibility="{Binding CanCompleteChecklistStop, Converter={StaticResource BoolVisibility}}" />
                        <Button Content="{Binding OverlayChecklistPreviousText}" Command="{Binding PreviousChecklistStopCommand}" Padding="8,4" Margin="0,6,0,0" Focusable="False"
                                Visibility="{Binding CanGoToPreviousChecklistStop, Converter={StaticResource BoolVisibility}}" />
                        <Button Content="{Binding OverlayChecklistCloseText}" Command="{Binding CloseShoppingGuidanceCommand}" Padding="8,4" Margin="0,6,0,0" Focusable="False"
                                Visibility="{Binding HasShoppingGuidance, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Border>
                </StackPanel>
                <Button Content="{Binding OverlayDetectShipButtonText}" Command="{Binding DetectShipFromOverlayCommand}"
                        Background="#1B4352" Foreground="#EAF5F4" BorderBrush="#69CFC0" Padding="10,6" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" Focusable="False"
                        Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding FleetScanHint}" Foreground="#91A5B8" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"
                           Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding OverlayModeButtonText}" Command="{Binding ToggleOverlayModeCommand}"
                            Padding="10,5" Margin="0,0,6,0" Focusable="False" />
                    <Button Grid.Column="1" Content="{Binding OverlayHideButtonText}" Command="{Binding HideOverlayCommand}"
                            Padding="10,5" Margin="0" Focusable="False" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Viewbox x:Name="OverlayScaleHost" Width="460" Stretch="Uniform" StretchDirection="Both"
             HorizontalAlignment="Left" VerticalAlignment="Top">
    <Border x:Name="OverlayChrome" Width="460" Background="#F20A121C" BorderBrush="#4B69CFC0" BorderThickness="1"
            CornerRadius="12" Padding="16" SnapsToDevicePixels="True">
        <StackPanel x:Name="OverlayContent" Opacity="{Binding OverlayTextOpacity}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="7" Height="7" Background="#69CFC0" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="SC NEXUS" Foreground="#F0F6FC" FontWeight="Bold" FontSize="13" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding OverlayEnvironmentDisplay}" Foreground="#69CFC0" FontWeight="Bold" FontSize="11" />
            </Grid>
            <StackPanel Visibility="{Binding OverlayShowShip, Converter={StaticResource BoolVisibility}}" Margin="0,11,0,0">
                <TextBlock Text="{Binding OverlayShipDisplay}" Foreground="#F0F6FC" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding OverlayShipSourceDisplay}" Foreground="#91A5B8" FontSize="10" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding OverlayShowLocation, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                <TextBlock Text="{Binding OverlayLocationDisplay}" Foreground="#DCE7F1" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding OverlayLocationSourceDisplay}" Foreground="#91A5B8" FontSize="10" Margin="0,3,0,0" />
            </StackPanel>
            <Border Background="#3D321B" BorderBrush="#9D7140" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,11,0,0"
                    Visibility="{Binding OverlayDanger, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding OverlayDangerDisplay}" Foreground="#FFD09B" FontWeight="Bold" FontSize="11" />
            </Border>
            <StackPanel Visibility="{Binding OverlayShowRoute, Converter={StaticResource BoolVisibility}}">
              <StackPanel Visibility="{Binding OverlayHasRoute, Converter={StaticResource BoolVisibility}}">
                <Border Height="1" Background="#293746" Margin="0,12,0,11" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OverlayRouteHeading}" Foreground="#69CFC0" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding OverlayProfitDisplay}" Foreground="#83E3D4" FontWeight="Bold" FontSize="15" Margin="12,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding OverlayStopDisplay}" Foreground="#F0F6FC" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding OverlayActionDisplay}" Foreground="#D3DFEA" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="92" />
                <TextBlock Text="{Binding OverlayCargoDisplay}" Foreground="#91A5B8" FontSize="11" Margin="0,6,0,0" />
                <ProgressBar Value="{Binding ActiveVoyageProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0"
                             Visibility="{Binding HasActiveVoyage, Converter={StaticResource BoolVisibility}}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding OverlayBalanceDisplay}" Foreground="#AFC1D1" FontSize="11" Margin="0,10,0,0" />
                <TextBlock Text="{Binding OverlayNextDisplay}" Foreground="#AFC1D1" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding OverlayShowRoute, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Visibility="{Binding OverlayShowMission, Converter={StaticResource BoolVisibility}}">
                <Border Background="#101B27" CornerRadius="6" Padding="10" Margin="0,9,0,0"
                        Visibility="{Binding OverlayHasMission, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding OverlayMissionDisplay}" Foreground="#DCE7F1" FontSize="11" TextWrapping="Wrap" MaxHeight="100" />
                    </StackPanel>
                </Border>
                </StackPanel>
                <TextBlock Text="{Binding OverlayFreshnessDisplay}" Foreground="#72879A" FontSize="10" Margin="0,7,0,0"
                           Visibility="{Binding OverlayShowFreshness, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding OverlayShipDetectionStatus}" Foreground="#91A5B8" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="60" />
            </StackPanel>
            <ContentControl x:Name="ActionsHost" Content="{Binding}" ContentTemplate="{StaticResource OverlayActions}" Margin="0,10,0,0" />
            <TextBlock Text="{Binding OverlayControlHint}" Foreground="#91A5B8" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
    </Viewbox>
</Window>
