<Window Foreground="{DynamicResource Text}" x:Class="SCNexus.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height" MaxHeight="440"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False">
    <Viewbox x:Name="OverlayScaleHost" Width="360" Stretch="Uniform" StretchDirection="Both"
             HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border x:Name="OverlayChrome" Width="360" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="8" Padding="12" SnapsToDevicePixels="True">
            <StackPanel x:Name="OverlayContent" Opacity="{Binding OverlayTextOpacity}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="7" Height="7" Background="{DynamicResource Accent}" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="SC NEXUS" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Input}" CornerRadius="4" Padding="6,2"
                            Visibility="{Binding OverlayDanger, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding OverlayDangerDisplay}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" FontSize="10" />
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding OverlayShowShip, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                    <TextBlock Text="{Binding OverlayShipDisplay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding OverlayLocationDisplay}" Visibility="{Binding OverlayShowLocation, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                <StackPanel Visibility="{Binding OverlayShowRoute, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Visibility="{Binding OverlayHasRoute, Converter={StaticResource BoolVisibility}}">
                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,10,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OverlayActionHeading}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Grid.Column="1" Text="{Binding OverlayProfitDisplay}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding OverlayActionDisplay}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding OverlayStopDisplay}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding OverlayNextDisplay}" Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVisibility}}"
                                   Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding OverlayControlHint}" Visibility="{Binding OverlayEditMode, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
