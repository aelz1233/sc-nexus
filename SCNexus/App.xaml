<Application x:Class="SCNexus.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B1118"/>
        <SolidColorBrush x:Key="Panel" Color="#151F2A"/>
        <SolidColorBrush x:Key="Accent" Color="#57D8D0"/>
        <SolidColorBrush x:Key="Muted" Color="#99ADBB"/>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#278EE5" Offset="0"/>
            <GradientStop Color="#6757D8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BalanceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#153B50" Offset="0"/>
            <GradientStop Color="#252044" Offset="1"/>
        </LinearGradientBrush>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F8FA"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Background" Value="#243543"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#273441"/><Setter Property="Foreground" Value="#8295A2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="11,8"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0E1923"/><Setter Property="BorderBrush" Value="#385465"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B2B3A"/>
            <Setter Property="BorderBrush" Value="#385465"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#1B2B3A"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
