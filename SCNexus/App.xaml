<Application x:Class="SCNexus.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#09121B"/>
        <SolidColorBrush x:Key="Panel" Color="#12212D"/>
        <SolidColorBrush x:Key="Accent" Color="#4ADAD4"/>
        <SolidColorBrush x:Key="Muted" Color="#90A7B7"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F8FA"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="#1C3442"/><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1C3442"/><Setter Property="BorderBrush" Value="#406073"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/></Style>
    </Application.Resources>
</Application>
